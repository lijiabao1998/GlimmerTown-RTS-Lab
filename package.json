{
  "name": "glimmertown-rts-lab",
  "private": true,
  "version": "0.0.1",
  "description": "微光小鎮 RTS 實驗線：二戰戰術即時戰略（three.js）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "unit": "node tools/unit.mjs",
    "smoke": "node tools/smoke.mjs",
    "check": "npm run typecheck && npm run unit && npm run build && npm run smoke"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
